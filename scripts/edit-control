#!/usr/bin/env bash
# edit-control - replace one value in a Remix-MUSIC-Sim control TOML in place.
#
# Rewrites only the value token, keeping the key's alignment padding and the
# trailing comment intact, so the resulting git diff is a single line per edit.
# Use this instead of sed for control edits; .githooks/pre-commit keeps the file
# canonical, and the clean diff is what a bulk edit should look like.
#
# Usage:
#   edit-control <file> <section.key> <newvalue>
#   edit-control <file> <key>         <newvalue>   # key in any section
#
# Examples:
#   scripts/edit-control analysis/37Cl/sim_control/37Cl_aa_s2.toml beam.energy 107.2
#   scripts/edit-control analysis/87Rb/sim_control/87Rb_beam.toml detector.strip -1
#
# Exits non-zero and leaves <file> untouched on no match or on error.

set -euo pipefail

f=$1; path=$2; newval=$3

if [[ "$path" == *.* ]]; then
    sect=${path%.*}
    key=${path##*.}
else
    sect=""
    key=$path
fi

out=$(mktemp)
trap 'rm -f "$out"' EXIT

if gawk -v sect="$sect" -v key="$key" -v newval="$newval" '
    /^\[/ { cur=$0; sub(/^\[/, "", cur); sub(/\]$/, "", cur) }
    {
        if ((sect == "" || cur == sect) && match($0, "^[[:space:]]*" key "[[:space:]]*=")) {
            eq  = index($0, "=")
            pre = substr($0, 1, eq)            # leading space + key padding + " ="
            rest= substr($0, eq + 1)
            inq = 0; hash = 0
            for (i = 1; i <= length(rest); i++) {
                c = substr(rest, i, 1)
                if (c == "\"") inq = !inq
                else if (c == "#" && !inq) { hash = i; break }
            }
            if (hash) { com = substr(rest, hash + 1); sub(/^[ \t]+/, "", com) } else com = ""
            print pre " " newval (com != "" ? " # " com : "")
            replaced = 1
            next
        }
        print
    }
    END {
        if (!replaced) {
            print "edit-control: no match for " (sect == "" ? "" : sect ".") key \
                  " in " FILENAME > "/dev/stderr"
            exit 1
        }
    }
' "$f" > "$out"; then
    mv "$out" "$f"
    trap - EXIT
else
    exit 1
fi
