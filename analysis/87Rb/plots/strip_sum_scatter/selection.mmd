---
title: 87Rb event selection
---
flowchart TB
  classDef cut fill:#f4f4f4,stroke:#555,color:#000;
  classDef note fill:#e8eef7,stroke:#555,color:#000;
  classDef tagged fill:#e3f2e1,stroke:#555,color:#000;
  classDef rej fill:none,stroke:none,color:#b00020;
  subgraph stage_0["input"]
    direction TB
    events["<b>calibrated events</b><br/>E(s) = strip total in beam units (beam = 1);<br/>beam gates fitted per subfile"]:::note
    beam_ref["<b>beam reference</b><br/>beam mean and σ per strip from the first<br/>subfile's pure-beam sample: every strip<br/>fired, inside the entrance (strips 0 vs 1)<br/>and exit (strips 16 vs 17) ellipses,<br/>3σ-clipped"]:::note
  end
  subgraph stage_1["event-level cuts"]
    direction TB
    all_strips["<b>all strips</b><br/>every strip 0-17 read above zero"]:::cut
    rej_all_strips["drop event"]:::rej
    gate["<b>beam gate</b><br/>strip 0 vs strip 1 inside the fitted beam<br/>ellipse at 5.0 × 5.0 σ"]:::cut
    rej_gate["drop event"]:::rej
    pileup["<b>pileup</b><br/>none of strips 1-16 at or above beam + 8.0<br/>σ"]:::cut
    rej_pileup["drop event"]:::rej
    noise["<b>noise</b><br/>none of strips 1-16 at or below beam −<br/>12.0 σ"]:::cut
    rej_noise["drop event"]:::rej
  end
  subgraph stage_2["per reaction strip"]
    direction TB
    reac_loop["<b>for each reaction strip reac = 2..11</b><br/>every strip is tested on its own; the first<br/>failing condition ends its test"]:::note
    upstream["<b>upstream beam</b><br/>every strip 1..reac−1 within 2.0 σ of the<br/>beam"]:::cut
    rej_upstream["no tag at reac"]:::rej
    jump["<b>jump</b><br/>E(reac) − E(reac−1) &gt; 1.0 σ(reac)"]:::cut
    rej_jump["no tag at reac"]:::rej
    reac_level["<b>reac level</b><br/>E(reac) &gt; beam + 1.0 σ(reac)"]:::cut
    rej_reac_level["no tag at reac"]:::rej
    smooth["<b>smoothness</b><br/>every step from reac+1 to strip 17 within<br/>8.0 σ"]:::cut
    rej_smooth["no tag at reac"]:::rej
    rerise["<b>re-rise</b><br/>once back within 1.0 σ of the beam after<br/>the peak, never above beam + 4.0 σ again"]:::cut
    rej_rerise["no tag at reac"]:::rej
    post_above["<b>post above</b><br/>strips reac+1 to reac+3 all above beam + 1.5<br/>σ"]:::cut
    rej_post_above["no tag at reac"]:::rej
    last_strip["<b>end strip</b><br/>strip 17 below beam − 3.0 σ"]:::cut
    rej_last_strip["no tag at reac"]:::rej
    cliff["<b>cliff</b><br/>the last step, strip 16 to 17, at most 50%<br/>of the fall from the peak"]:::cut
    rej_cliff["no tag at reac"]:::rej
  end
  subgraph stage_3["outcome"]
    direction TB
    tagged["<b>tagged</b><br/>a reaction at reac; an event may tag at more<br/>than one strip"]:::tagged
    n_beam["<b>beam count</b><br/>events past the event-level cuts with beam<br/>upstream of reac: the denominator"]:::note
    xs["<b>cross section, all tagged</b><br/>σ(reac) = tagged / (beam count × target<br/>atoms per strip); systematic: each threshold<br/>shifted ±0.1 σ (cliff ±0.10), one at a<br/>time, largest change per threshold in<br/>quadrature"]:::note
  end
  events --> beam_ref
  beam_ref --> all_strips
  all_strips --> gate
  gate --> pileup
  pileup --> noise
  noise --> reac_loop
  reac_loop --> upstream
  upstream --> jump
  jump --> reac_level
  reac_level --> smooth
  smooth --> rerise
  rerise --> post_above
  post_above --> last_strip
  last_strip --> cliff
  cliff --> tagged
  tagged --> xs
  n_beam --> xs
  all_strips -.-> rej_all_strips
  gate -.-> rej_gate
  pileup -.-> rej_pileup
  noise -.-> rej_noise
  upstream -.-> rej_upstream
  jump -.-> rej_jump
  reac_level -.-> rej_reac_level
  smooth -.-> rej_smooth
  rerise -.-> rej_rerise
  post_above -.-> rej_post_above
  last_strip -.-> rej_last_strip
  cliff -.-> rej_cliff
