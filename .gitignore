*.toml 
*.srim
# Track the sim controls and their reference tables: each control is one run and
# every .srim/.tab pins a stopping/TALYS table the run depends on, unlike the
# generated traces_*.root and logs that stay ignored. scripts/format-controls
# keeps the TOMLs canonical so a hand edit or sed never inflates the diff.
!analysis/*/sim_control/*.toml
!analysis/*/sim_root_files/*.srim
!analysis/*/sim_root_files_catima/*.srim
!analysis/*/sim_root_files_srim/*.srim
upstream
*.log
*.html
*.md
CLAUDE.md
QWEN.md 
.qwen 
.claude/*
.claude/settings.json
secrets/settings.json
settings.json
*.fits
*.npz
*.npy
*.txt
*.C
*.h5
*.hdf5
*.pkl
__pycache__
*.pdf
*.root
*.header
*.a
*.so
*.o
*.d
*.pcm
result*
*.png

scripts/anl-tunnel.sh

# monorepo: per-dataset binaries (no extension) + editor/junk
analysis/*/bin/
# everything under plots/ is regenerated by the run (wipe-plots deletes it),
# including the selection diagrams the *.png/*.root patterns above miss
analysis/*/plots/
.clangd
\#*\#

# ML artifacts (generated)
analysis/*/models/
analysis/*/ml_cache/
*.pt

# Source assets, not build output — the blanket *.txt above would eat these.
!tooling/assets/*.txt
# TALYS, driven by talys-xs: the run and its graphs live under
# analysis/<dataset>/root_files/talys/. The file patterns are talys-nix's own
# ignore list, so a TALYS run anywhere in the tree stays out too.
analysis/*/root_files/talys/
*.tot
*.pot
*.LST
*.respoint*
*.res.tendl.*
*.inp

# generated API reference
/docs/

# Documentation sources, not generated notes — the blanket *.md above would eat
# these. The narrative pages are inputs to the doxygen site and are tracked.
!doc/pages/*.md
# Notes for coding agents working in this repository.
!/AGENTS.md
