#!/usr/bin/env bash
# Reformat staged C/C++ files with clang-format and re-stage them, and keep
# the README's banner identical to tooling/assets/music.txt, which is what
# the tooling prints.
set -e

STYLE='{BasedOnStyle: LLVM, BreakStringLiterals: false}'
BANNER=tooling/assets/music.txt

# The banner is the first fenced block in the README; its body is replaced
# with the asset, line for line.
if [ -f README.md ] && [ -f "$BANNER" ]; then
    awk -v banner="$BANNER" '
        /^```$/ && !done {
            print
            if (!inblk) {
                while ((getline line < banner) > 0) print line
                inblk = 1
            } else {
                done = 1
            }
            next
        }
        inblk && !done { next }
        { print }
    ' README.md > README.md.tmp
    if ! cmp -s README.md README.md.tmp; then
        mv README.md.tmp README.md
        git add README.md
    else
        rm README.md.tmp
    fi
fi

files=$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '\.(c|cc|cpp|cxx|h|hpp|hxx)$' || true)

[ -z "$files" ] && exit 0

for f in $files; do
    clang-format -i --style="$STYLE" "$f"
    git add "$f"
done
